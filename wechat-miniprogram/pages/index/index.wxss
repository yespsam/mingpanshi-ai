.page {
  min-height: 100vh;
  padding: 32rpx 28rpx 56rpx;
  background:
    radial-gradient(circle at 82% 2%, rgba(212, 175, 55, 0.22), transparent 30%),
    radial-gradient(circle at 0% 18%, rgba(75, 45, 111, 0.12), transparent 28%),
    linear-gradient(180deg, #fbfaf7 0%, #f7f6f3 52%, #f0eee7 100%);
}

.header {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-bottom: 24rpx;
}

.brand-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 78rpx;
  height: 78rpx;
  border: 3rpx solid #d4af37;
  border-radius: 22rpx;
  color: #e8d5a1;
  font-size: 34rpx;
  font-weight: 800;
  background: linear-gradient(135deg, #1a1438, #4b2d6f 58%, #0d3b3b);
  box-shadow: 0 16rpx 40rpx rgba(26, 20, 56, 0.16);
}

.brand-title {
  color: #1a1438;
  font-size: 36rpx;
  font-weight: 800;
}

.brand-subtitle {
  margin-top: 4rpx;
  color: #4b2d6f;
  font-size: 22rpx;
  font-weight: 600;
}

.status {
  display: inline-flex;
  max-width: 100%;
  margin-bottom: 24rpx;
  padding: 12rpx 18rpx;
  border: 1rpx solid rgba(212, 175, 55, 0.38);
  border-radius: 999rpx;
  color: #9a7629;
  background: rgba(255, 255, 255, 0.72);
  font-size: 24rpx;
}

.status.ready {
  color: #157a65;
  border-color: rgba(13, 59, 59, 0.24);
}

.status.warn {
  color: #a26a14;
}

.luopan-card,
.panel {
  margin-bottom: 24rpx;
  padding: 28rpx;
  border: 1rpx solid rgba(75, 45, 111, 0.12);
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.86);
  box-shadow: 0 24rpx 72rpx rgba(26, 20, 56, 0.1);
}

.luopan-card {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.luopan {
  position: relative;
  width: 430rpx;
  height: 430rpx;
  margin: 6rpx auto 28rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 50% 50%, rgba(232, 213, 161, 0.38), transparent 64%);
}

.ring {
  position: absolute;
  border: 2rpx solid rgba(212, 175, 55, 0.52);
  border-radius: 50%;
}

.outer {
  inset: 0;
}

.middle {
  inset: 86rpx;
  border-style: dashed;
  border-color: rgba(75, 45, 111, 0.22);
}

.inner {
  inset: 154rpx;
}

.core {
  position: absolute;
  left: 165rpx;
  top: 165rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100rpx;
  height: 100rpx;
  border: 2rpx solid #d4af37;
  border-radius: 50%;
  color: #e8d5a1;
  font-size: 48rpx;
  font-weight: 800;
  background: #1a1438;
}

.tri {
  position: absolute;
  color: #9a7629;
  font-size: 38rpx;
}

.tri-1 { top: 44rpx; left: 198rpx; }
.tri-2 { top: 86rpx; right: 96rpx; }
.tri-3 { top: 198rpx; right: 48rpx; }
.tri-4 { right: 96rpx; bottom: 86rpx; }
.tri-5 { left: 198rpx; bottom: 44rpx; }
.tri-6 { left: 96rpx; bottom: 86rpx; }
.tri-7 { top: 198rpx; left: 48rpx; }
.tri-8 { top: 86rpx; left: 96rpx; }

.hero-copy {
  width: 100%;
}

.eyebrow,
.panel-title {
  color: #9a7629;
  font-size: 28rpx;
  font-weight: 800;
}

.hero-title {
  margin-top: 14rpx;
  color: #1a1438;
  font-size: 44rpx;
  font-weight: 800;
  line-height: 1.2;
}

.hero-text {
  margin-top: 14rpx;
  color: #5f596d;
  font-size: 28rpx;
  line-height: 1.75;
}

.field {
  margin-top: 22rpx;
}

.label {
  margin-bottom: 10rpx;
  color: #746f82;
  font-size: 25rpx;
}

.control {
  width: 100%;
  min-height: 92rpx;
  padding: 24rpx;
  border: 1rpx solid rgba(75, 45, 111, 0.14);
  border-radius: 20rpx;
  color: #17132b;
  background: rgba(255, 255, 255, 0.9);
  font-size: 29rpx;
}

.picker-value {
  display: flex;
  align-items: center;
}

.textarea {
  min-height: 160rpx;
  line-height: 1.65;
}

.primary,
.ghost {
  width: 100%;
  height: 96rpx;
  margin-top: 28rpx;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 800;
}

.primary {
  color: #ffffff;
  background: linear-gradient(135deg, #1a1438, #4b2d6f);
  box-shadow: 0 16rpx 34rpx rgba(75, 45, 111, 0.22);
}

.ghost {
  color: #1a1438;
  border: 1rpx solid rgba(75, 45, 111, 0.18);
  background: rgba(255, 255, 255, 0.74);
}

.fine-print {
  margin-top: 22rpx;
  color: #746f82;
  font-size: 23rpx;
  line-height: 1.7;
}

.pillar,
.element-row,
.domain-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.pillar {
  padding: 22rpx 0;
  border-bottom: 1rpx solid rgba(75, 45, 111, 0.1);
  color: #1a1438;
  font-size: 28rpx;
}

.element,
.domain,
.annual,
.report-section {
  margin-top: 20rpx;
  padding: 22rpx;
  border: 1rpx solid rgba(75, 45, 111, 0.1);
  border-radius: 22rpx;
  background: rgba(247, 246, 243, 0.68);
}

.element-row,
.domain-top {
  color: #1a1438;
  font-size: 28rpx;
  font-weight: 800;
}

.bar {
  height: 12rpx;
  margin-top: 16rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: rgba(75, 45, 111, 0.08);
}

.bar-fill {
  height: 100%;
  border-radius: 999rpx;
  background: #d4af37;
}

.element-木 { background: #208c76; }
.element-火 { background: #d96a55; }
.element-土 { background: #c4933a; }
.element-金 { background: #9f9a8f; }
.element-水 { background: #3b77b8; }

.domain-text,
.section-body {
  margin-top: 12rpx;
  color: #5f596d;
  font-size: 27rpx;
  line-height: 1.75;
}

.section-title {
  color: #4b2d6f;
  font-size: 29rpx;
  font-weight: 800;
}

.lucky {
  margin-top: 20rpx;
  padding: 22rpx;
  border: 1rpx solid rgba(212, 175, 55, 0.32);
  border-radius: 22rpx;
  color: #835e13;
  background: rgba(232, 213, 161, 0.28);
  font-size: 27rpx;
  line-height: 1.7;
}
