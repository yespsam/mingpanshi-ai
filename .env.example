OPENAI_API_KEY=
OPENAI_MODEL=kimi-k2.5
OPENAI_BASE_URL=https://api.moonshot.cn/v1
OPENAI_API_STYLE=chat
MODEL_PROVIDER=Kimi
MODEL_RESPONSE_FORMAT=json
KIMI_THINKING=disabled
OPENAI_MAX_OUTPUT_TOKENS=4200
OPENAI_CHAT_MAX_TOKENS=1800
MODEL_REQUEST_TIMEOUT_MS=60000
PRODUCT_ACCESS_MODE=free
PORT=8787

# Stable public URL, required for crypto payment webhook/callback URLs.
PUBLIC_SITE_URL=https://your-domain.com

# Crypto payment gateway. Use demo locally; use crypto in production.
PAYMENT_MODE=demo
PAYMENT_PROVIDER=nowpayments
NOWPAYMENTS_API_BASE=https://api.nowpayments.io/v1
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
CRYPTO_PRICE_AMOUNT=0.70
CRYPTO_PRICE_CURRENCY=usd
CRYPTO_PAY_CURRENCY=
CRYPTO_SUCCESS_STATUSES=finished
